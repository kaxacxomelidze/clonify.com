{
  "manifest_version": 3,
  "name": "Clonyfy Helper",
  "short_name": "Clonyfy Helper",
  "version": "1.0.1",
  "description": "Clone protected sites with Clonyfy from your own browser. Copies only the public page, never cookies, logins or personal data.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clonyfy Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://clonyfy.com/*",
    "https://www.clonyfy.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://clonyfy.com/*",
        "https://www.clonyfy.com/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
