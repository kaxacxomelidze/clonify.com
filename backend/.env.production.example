# Template for Docker Compose: copy to backend/.env.production and fill secrets.
# compose.yaml loads ./backend/.env.production

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

ADMIN_PASSWORD=
PASSWORD_PEPPER=
SHARE_PASSWORD_PEPPER=

PORT=5000
NODE_ENV=production
CLONYFY_HOSTED=1
CLONYFY_QUALITY=1
CLONYFY_OUTPUT_DIR=/data/output

APP_URL=https://clonyfy.com
FRONTEND_URL=https://clonyfy.com
PUBLIC_APP_URL=https://clonyfy.com
SHARE_BASE_URL=https://clonyfy.com
CORS_ORIGINS=https://clonyfy.com,https://www.clonyfy.com

CLONYFY_FULL_SITE_MAX_PAGES=10000
CLONYFY_FULL_SITE_DEPTH=256
CLONYFY_FULL_SITE_DEADLINE_MS=14400000
CLONYFY_FULL_SITE_SITEMAP_CAP=2000
CLONYFY_CLONE_CONCURRENCY=2

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

FIGMA_COMMUNITY_PLUGIN_URL=https://www.figma.com/community/plugin/1677522506571131225/Clonyfy-Import
