# Template for Docker Compose: copy to backend/.env.production and fill secrets.
# compose.yaml loads ./backend/.env.production

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

ADMIN_PASSWORD=
PASSWORD_PEPPER=
SHARE_PASSWORD_PEPPER=

PORT=5000
NODE_ENV=production
CLONYFY_HOSTED=1
CLONYFY_QUALITY=1
CLONYFY_OUTPUT_DIR=/data/output

APP_URL=https://clonyfy.com
FRONTEND_URL=https://clonyfy.com
PUBLIC_APP_URL=https://clonyfy.com
SHARE_BASE_URL=https://clonyfy.com
CORS_ORIGINS=https://clonyfy.com,https://www.clonyfy.com

CLONYFY_FULL_SITE_MAX_PAGES=10000
CLONYFY_FULL_SITE_DEPTH=256
CLONYFY_FULL_SITE_DEADLINE_MS=14400000
CLONYFY_FULL_SITE_SITEMAP_CAP=2000
CLONYFY_CLONE_CONCURRENCY=2

# Email (verification codes at sign-up AND login, password reset, receipts).
# Without SMTP, login codes are off and a password alone signs users in.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Funnel analytics → Mixpanel (Project settings → Project token). Setup: docs/mixpanel-setup.md
MIXPANEL_TOKEN=
# Payments — Whop (webhook: https://clonyfy.com/api/whop/webhook). Setup: docs/whop-setup.md
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Starter $17.99/mo · $118.73/yr
WHOP_PLAN_STARTER_MONTHLY=
WHOP_PLAN_STARTER_ANNUAL=
# Growth $26.99/mo · $178.13/yr
WHOP_PLAN_GROWTH_MONTHLY=
WHOP_PLAN_GROWTH_ANNUAL=
# Pro $79.99/mo · $527.93/yr (WHOP_PLAN_SCALE_* is still read if these are empty)
WHOP_PLAN_PRO_MONTHLY=
WHOP_PLAN_PRO_ANNUAL=
# Checkout add-on: +15 website clones for $20 (one-time)
WHOP_PLAN_ADDON_CLONES15=
# Exit offer: Growth, $161.94 the first year, then $178.13/yr
WHOP_PLAN_GROWTH_DOWNSELL=
# Optional: pin Whop's API version (e.g. 2025-01-01) if the key was created on a newer one.
WHOP_API_VERSION_DATE=
# Shown on the affiliate pages, e.g. "30% recurring". The real rate is set in Whop → Marketing → Affiliates.
WHOP_AFFILIATE_COMMISSION=

# Social login — redirect URIs must use APP_URL:
#   https://clonyfy.com/api/auth/google/callback
#   https://clonyfy.com/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FIGMA_COMMUNITY_PLUGIN_URL=https://www.figma.com/community/plugin/1677522506571131225/Clonyfy-Import
